# InterCat Lynx - configuration for docker compose
#
# Easiest way: run  ./scripts/init-env.sh  - it creates .env from this file and
# fills in random secrets. Do it by hand only if you must: copy this file to
# .env and replace every line marked  <-- REQUIRED.
#
# Never commit .env to git. It contains your secrets.

# =============================================================================
# REQUIRED
# =============================================================================

# Password of the database. Docker creates the database with it on the first
# start. Changing it later does NOT change the existing database.
POSTGRES_PASSWORD=                    # <-- REQUIRED

# Signs the login tokens and encrypts stored secrets (SMTP password, webhook
# secrets). At least 32 random characters. The backend refuses to start with an
# example value. Never change it on a running installation: all logins end and
# stored secrets become unreadable.
SECRET_KEY=                           # <-- REQUIRED

# Address under which you open the site, without a trailing slash. Used for the
# links in e-mails and notifications.
#   first test on this machine:  http://localhost
#   test VM in the LAN:          http://192.168.1.50
#   real installation:           https://lynx.example.org
PUBLIC_URL=http://localhost

# Second signing key (CSRF protection). init-env.sh generates it; by hand use
# any random value of at least 32 characters.
CSRF_SECRET_KEY=

# production = strict checks (the backend refuses to start with a weak
# SECRET_KEY). Leave it unless you develop on this machine.
ENVIRONMENT=production

# Database name and user. The internal names are historical (the project is a
# fork of OpenThreat). Leave them as they are; changing them later does not
# rename the existing database.
POSTGRES_DB=openthreat
POSTGRES_USER=openthreat

# =============================================================================
# SETUP ASSISTANT
# =============================================================================

# Code the setup assistant asks for on the first visit, so that nobody else can
# create the first administrator before you. init-env.sh generates one.
# Empty = the backend generates one and prints it into its log:
#   docker compose logs backend | grep -A3 "not set up"
SETUP_TOKEN=

# =============================================================================
# WEB SERVER (nginx)
# =============================================================================

# Which nginx configuration to use:
#   ./nginx/nginx.http.conf  plain HTTP. Good for a first test, or when another
#                            proxy in front (company proxy, Cloudflare, load
#                            balancer) does the HTTPS part.
#   ./nginx/nginx.conf       HTTPS. Needs nginx/ssl/nginx.crt and nginx.key
#                            (./scripts/init-env.sh --https creates a
#                            self-signed pair for tests).
NGINX_CONF=./nginx/nginx.http.conf

# Ports on the server. Change them if 80/443 are already in use.
HTTP_PORT=80
HTTPS_PORT=443

# Number of API containers. 1 is enough for a test, 2 for production.
BACKEND_REPLICAS=2
WORKER_REPLICAS=1

# How many reverse proxies stand between the visitor and the backend.
#   1 = only the nginx of this compose file (default, correct for most)
#   2 = another proxy in front of it; also configure nginx's real_ip module
# A wrong value lets visitors fake their address and dodge rate limits.
TRUSTED_PROXIES=1

# =============================================================================
# OPTIONAL
# =============================================================================

# Free key from https://nvd.nist.gov/developers/request-an-api-key - makes the
# CVE import about ten times faster. The setup assistant can also store it.
NVD_API_KEY=

# E-mail (verification codes, alerts). The setup assistant can set this up in
# the web interface; the values here are the fallback.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InterCat Lynx

# Webhooks to private addresses (192.168.x.x, 10.x.x.x, localhost) are blocked
# so that nobody can use them to probe your internal network. Set to true only
# if your webhook target (Zabbix, Gotify, ...) is inside your own network.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Separate key for stored secrets. Empty = derived from SECRET_KEY. If you set
# it, never change it afterwards.
ENCRYPTION_KEY=

# Requests per visitor (the nginx in front limits as well)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# Own, larger budget for the status polling of the import display (see backend/middleware)
RATE_LIMIT_STATUS_PER_MINUTE=120
RATE_LIMIT_STATUS_PER_HOUR=4000
# IPs that are exempt from the limit, comma separated (for example a monitoring server)
RATE_LIMIT_WHITELIST=

LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only if the API runs on a different address than the website. Leave empty
# when nginx serves both (default). Needs a rebuild: docker compose build frontend
NEXT_PUBLIC_API_URL=

# Browser origins allowed to call the API directly (CORS). With the default
# setup everything goes through nginx on one address, so this does not matter.
ALLOWED_ORIGINS=

# Local AI features (optional, see the commented-out ollama service in
# docker-compose.yml)
OLLAMA_HOST=
LLM_MODEL=

# =============================================================================
# DEVELOPMENT (docker-compose.dev.yml, backend started on the host)
# =============================================================================
# The values below are only read when you start the backend on your own machine
# (see DEVELOPMENT_SETUP.md). The production stack ignores them.
#
# DATABASE_URL=postgresql://openthreat:openthreat@localhost:5432/openthreat
# REDIS_URL=redis://localhost:6379/0
# ENVIRONMENT=development
